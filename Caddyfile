{
    auto_https off
}

:80 {
    encode gzip zstd

    handle_path /api* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy ui:80
    }
}

:443 {
    tls internal
    encode gzip zstd

    handle_path /api* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy ui:80
    }
}
